<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.lagrangeController">
    <Label text="Interpolación de Lagrange" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Valores X (sep. por coma):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="xInput" promptText="Ej: 0, 1, 2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Valores Y (sep. por coma):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="yInput" promptText="Ej: 1, 3, 2" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Valor a interpolar (x):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="targetXField" promptText="Ej: 1.5" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Button text="Calcular" onAction="#calculateLagrange" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2" maxWidth="Infinity" />
    </GridPane>
    <TextField fx:id="resultField" editable="false" promptText="Resultado P(x)" />
    <Button text="Volver al Menú" onAction="#switchToMenu" />
</VBox>