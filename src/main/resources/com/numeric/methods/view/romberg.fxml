<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.rombergController">
    <children>
    <Label text="Punto Fijo" />
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <!-- Etiquetas y campos de texto -->
            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="functionField" promptText="Ej: x^3-4*x-2" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Límite inferior (a):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="initialPointField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Límite superior (b):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="finalPointField" promptText="Ej: 2" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Número de iteraciones:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="iterationsField" promptText="Ej: 10" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <!-- Botón calcular -->
            <!--<Button fx:id="calculateButton" text="Calcular" onAction="#calculateFixPoint" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2" alignment="CENTER" />-->
        </GridPane>
        <!-- Tabla dinámica fuera del GridPane -->
        <TableView fx:id="resultsTable" prefHeight="400" prefWidth="800">
            <columns>
                <TableColumn fx:id="levelColumn" text="Iteración" prefWidth="100" />
                <TableColumn fx:id="segmentColumn" text="n" prefWidth="100" />
                <TableColumn fx:id="stepsColumn" text="h_i" prefWidth="100" />
                <TableColumn fx:id="trapezoidalColumn" text="R_{i,0} [Trapecio]" prefWidth="100" />
                <TableColumn fx:id="simpson13Column" text="R_{i,1} [Simpson 1/3]" prefWidth="100" />
                <TableColumn fx:id="simpson38Column" text="R_{i,2} [Simpson 3/8]" prefWidth="100" />
            </columns>
        </TableView>
        
        <Button fx:id="secondaryButton" text="Volver" onAction="#switchToMenu" />

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>


    
</VBox>
