<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.rombergController">
    <children>
        <Label text="Integración de Romberg" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="functionField" promptText="Ej: exp(x)" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Límite inferior (a):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="aField" promptText="Ej: 0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Límite superior (b):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="bField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Niveles (n):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="nField" promptText="Ej: 4" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Button fx:id="calculateButton" text="Calcular Integral" onAction="#calculateRomberg" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" maxWidth="Infinity" />
        </GridPane>

        <TableView fx:id="resultsTable" prefHeight="400" prefWidth="800">
            <columns>
                <TableColumn fx:id="iColumn" text="i" prefWidth="50" />
                <TableColumn fx:id="j0Column" text="R(i,0)" prefWidth="150" />
                <TableColumn fx:id="j1Column" text="R(i,1)" prefWidth="150" />
                <TableColumn fx:id="j2Column" text="R(i,2)" prefWidth="150" />
                <TableColumn fx:id="j3Column" text="R(i,3)" prefWidth="150" />
            </columns>
        </TableView>
        
        <Button text="Volver al Menú" onAction="#switchToMenu" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>