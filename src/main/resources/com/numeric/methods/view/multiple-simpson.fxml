<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.multipleSimpsonController">
    <children>
        <Label text="Simpson Múltiple" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <Label text="Método:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="methodSelector" promptText="Selecciona un método" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="functionField" promptText="Ej: x^3-4*x-2" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Límite inferior (a):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="initialPointField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Límite superior (b):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="finalPointField" promptText="Ej: 10" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Número de segmentos (n):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="segmentsField" promptText="Ej: 10" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Button fx:id="calculateButton" text="Calcular" onAction="#calculateMultipleSimpson" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2" maxWidth="Infinity" />
            
            <Label text="Resultado:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <TextField fx:id="resultField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </GridPane>

        <TableView fx:id="resultsTable" prefHeight="300" prefWidth="600">
            <columns>
                <TableColumn fx:id="iterationColumn" text="Iteración" prefWidth="100" />
                <TableColumn fx:id="xiColumn" text="x_i" prefWidth="100" />
                <TableColumn fx:id="fxiColumn" text="f(x_i)" prefWidth="100" />
                <TableColumn fx:id="weightColumn" text="Peso" prefWidth="100" />
                <TableColumn fx:id="contributionColumn" text="Contribución" prefWidth="150" />
            </columns>
        </TableView>
        
        <Button text="Volver" onAction="#switchToMenu" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>