<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.rootsPolynomialsController">
    <children>
        <Label text="Solucionador de Polinomios (Müller + Deflación)" styleClass="label" />
        
        <HBox spacing="30.0" alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="12.0" alignment="TOP_CENTER" prefWidth="380.0">
                    <children>
                        <GridPane hgap="10" vgap="10" alignment="CENTER">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Grado del Polinomio (n):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="degreeField" promptText="Ej: 3" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="text-field" />

                                <Label text="Semilla p0 (Real):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="pZeroField" promptText="Ej: 0.0" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="text-field" />

                                <Label text="Semilla p1 (Real):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="pOneField" promptText="Ej: 0.5" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="text-field" />

                                <Label text="Semilla p2 (Real):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="pTwoField" promptText="Ej: 1.0" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="text-field" />

                                <Label text="Tolerancia (Es):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="errorField" promptText="Ej: 0.0001" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="text-field" />
                            </children>
                        </GridPane>
                        
                        <HBox spacing="15.0" alignment="CENTER">
                            <children>
                                </children>
                        </HBox>
                        
                        <Separator prefWidth="200.0" />
                        
                        <Label text="Coeficientes del Polinomio" styleClass="label" style="-fx-font-size: 14px;" />
                        <TableView fx:id="coefficientsTable" prefHeight="180.0" prefWidth="350.0" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="termColumn" text="Término" prefWidth="100.0" />
                                <TableColumn fx:id="coefficientValueColumn" text="Valor Real (a_i)" prefWidth="230.0" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                
                <VBox spacing="15.0" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Historial de Convergencia por Raíz (Müller)" styleClass="label" style="-fx-font-size: 15px;" />
                        
                        <TableView fx:id="resultsTable" prefHeight="220.0" prefWidth="550.0" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="iterationColumn" text="Iteración (i)" prefWidth="85.0" />
                                <TableColumn fx:id="computedAColumn" text="Coef. a" prefWidth="90.0" />
                                <TableColumn fx:id="computedBColumn" text="Coef. b" prefWidth="90.0" />
                                <TableColumn fx:id="currentX3Column" text="Aprox. x3" prefWidth="160.0" />
                                <TableColumn fx:id="errorColumn" text="Error (%)" prefWidth="105.0" />
                            </columns>
                        </TableView>
                        
                        <Separator prefWidth="200.0" />
                        
                        <Label text="Raíces Finales del Polinomio (Reales y Complejas)" styleClass="label" style="-fx-font-size: 15px;" />
                        <ListView fx:id="rootsListView" prefHeight="130.0" prefWidth="550.0" styleClass="table-view" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <Button fx:id="secondaryButton" text="Volver al Menú" onAction="#switchToMenu" styleClass="button" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>