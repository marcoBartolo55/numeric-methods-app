<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.trapezoidalRuleController">
    <children>
    <Label text="Regla de Trapecio" />
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <!-- Etiquetas y campos de texto -->
            <Label text="Tipo de regla:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="methodComboBox" promptText="Selecciona..." GridPane.columnIndex="1" GridPane.rowIndex="0">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Simple" />
                        <String fx:value="Compuesta" />
                    </FXCollections>
                </items>
            </ComboBox>

            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="functionField" promptText="Ej: x^3-4*x-2" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Límite inferior (a):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="lowerLimitField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Límite superior (b):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="upperLimitField" promptText="Ej: 2" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Número de trapecios:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="numberTrapField" promptText="Ej: 10 (en caso de ser simple n = 1)" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label fx:id="resultLabel" text="Resultado: " styleClass="result-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="resultField" editable="false" styleClass="output-text-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <!-- Botón calcular -->
            <Button fx:id="calculateButton" text="Calcular" onAction="#calculateTrapezoidalRule" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2" alignment="CENTER" />
        </GridPane>

        
        <Button fx:id="secondaryButton" text="Volver" onAction="#switchToMenu" />

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>


    
</VBox>
