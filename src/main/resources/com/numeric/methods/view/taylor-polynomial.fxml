<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.taylorPolynomialController">
    <children>
        <Label text="Polinomio de Taylor" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="functionField" promptText="Ej: sin(x)" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Punto de expansión (a):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="expansionPointField" promptText="Ej: 0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Valor a evaluar (x):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="targetXField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Orden del polinomio (n):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="orderField" promptText="Ej: 5" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Button fx:id="calculateButton" text="Calcular" onAction="#calculateTaylor" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2" maxWidth="Infinity" />
        </GridPane>

        <TableView fx:id="resultsTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="nColumn" text="Orden (n)" prefWidth="100" />
                <TableColumn fx:id="termColumn" text="Valor del Término" prefWidth="250" />
                <TableColumn fx:id="sumColumn" text="Suma Parcial" prefWidth="250" />
            </columns>
        </TableView>
        
        <Button fx:id="secondaryButton" text="Volver" onAction="#switchToMenu" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>