<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.mainController">

   <children>
      <Label text="Menú Principal - Opciones" />
      <GridPane hgap="120" vgap="20" alignment="CENTER">
         <Button fx:id="rootsAproximationButton" text="Raíces de Ecuaciones y Aproximación" onAction="#switchToRootsAproximationMenu" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <Button fx:id="numericalDifferentiationIntegrationButton" text="Diferenciación e Interpolación" onAction="#switchToNumericalDifferentiationIntegration" GridPane.columnIndex="0" GridPane.rowIndex="1" />
         <Button fx:id="ordinaryDifferentialEquationsButton" text="Ecuaciones Diferenciales e Integración" onAction="#switchToOrdinaryDifferentialEquations" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      </GridPane>
   </children>
      <Button fx:id="exitButton" text="Salir" onAction="#exitApplication"/>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
