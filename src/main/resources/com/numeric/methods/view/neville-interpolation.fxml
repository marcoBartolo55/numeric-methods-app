<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.nevilleInterpolationController">
    <children>
        <Label text="Interpolación de Neville" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        
        <HBox spacing="30.0" alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="15.0" alignment="TOP_CENTER" prefWidth="350.0">
                    <children>
                        <GridPane hgap="10" vgap="12" alignment="CENTER">
                            <Label text="Valores x (separados por coma):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="xInput" promptText="Ej: 0, 2, 3" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Valores y (separados por coma):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="yInput" promptText="Ej: 1, 3, 2" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Valor a interpolar (x):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="targetXField" promptText="Ej: 1.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </GridPane>
                        
                        <Button text="Calcular Interpolación" onAction="#calculateNeville" />
                        
                        <Separator />
                        
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="Resultado P(x):" style="-fx-font-weight: bold;" />
                            <TextField fx:id="finalResultField" editable="false" />
                        </HBox>
                    </children>
                </VBox>
                
                <VBox spacing="10.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Tabla de Neville (Dinámica)" style="-fx-font-size: 14px;" />
                        <TableView fx:id="resultTable" prefHeight="400.0" prefWidth="600.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <Button text="Volver al Menú" onAction="#switchToMenu" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>