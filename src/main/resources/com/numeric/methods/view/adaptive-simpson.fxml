<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.numeric.methods.controllers.adaptiveSimpsonController">
    <children>
    <Label text="Simpson 1/3 Adapatativo" />
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <!-- Etiquetas y campos de texto -->
            <Label text="Función f(x):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="functionField" promptText="Ej: x^3-4*x-2" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Límite inferior (a):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="lowerLimitField" promptText="Ej: 1" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Límite superior (b):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="upperLimitField" promptText="Ej: 2" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Tolerancia de error:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="toleranceField" promptText="Ej: 0.001" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Resultado Aproximado:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="resultField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <!-- Botón calcular -->
            <Button fx:id="calculateButton" text="Calcular" onAction="#calculateAdaptiveSimpson" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2" alignment="CENTER" />
        </GridPane>
        
        <Button fx:id="secondaryButton" text="Volver" onAction="#switchToMenu" />

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>


    
</VBox>
